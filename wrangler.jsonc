{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "erc-cal",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "minify": true,
  // Only reachable through the custom domain, which Cloudflare Access
  // protects. A workers.dev or preview URL would skip the login.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "erc-cal",
      "database_id": "d18e6e2c-47d0-42df-91d3-2672432861ca",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Cloudflare Access: team domain and the ERC-CAL application's audience tag.
    "ACCESS_TEAM_DOMAIN": "https://broad-violet-42c8.cloudflareaccess.com",
    "ACCESS_AUD": "cb755a6aa4ab3eccaf353196c61e2d3c4ef979689c5f6d457ba6611a905e9e60",
    // "true" only in .dev.vars for local development.
    "AUTH_DISABLED": ""
  }
  // Secret, not a var: ALLOWED_EMAILS (comma-separated), set with
  //   npx wrangler secret put ALLOWED_EMAILS
}
