{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "erc-cal",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "minify": true,
  // Builds public/styles.css before every `wrangler dev` and `wrangler deploy`.
  "build": { "command": "npm run build:css" },
  // The app is plain files served by Workers Static Assets: free, unlimited
  // and cached at the edge. Only /api/* (VIN decoding) runs the Worker.
  // Visitors' garages live in their own browsers, so there is no database.
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "tokyomodelvault.com", "custom_domain": true },
    { "pattern": "staging.tokyomodelvault.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
