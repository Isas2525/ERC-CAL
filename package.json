{
  "name": "erc-cal",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.21.0",
  "scripts": {
    "build:css": "tailwindcss -i styles/input.css -o public/styles.css --minify",
    "build": "npm run build:css && node scripts/build-assets.mjs",
    "dev": "npm run build && wrangler dev",
    "typecheck": "npm run build && wrangler types --strict-vars=false && tsc --noEmit",
    "test": "npm run build && vitest run",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.151.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true,
    "@parcel/watcher": false
  }
}
