{
  "name": "tokyo-model-vault",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.21.0",
  "scripts": {
    "build:css": "tailwindcss -i styles/input.css -o public/styles.css --minify",
    "dev": "wrangler dev",
    "db:migrate": "wrangler d1 migrations apply erc-cal --remote",
    "db:migrate:local": "wrangler d1 migrations apply erc-cal --local",
    "typecheck": "wrangler types --strict-vars=false && tsc --noEmit",
    "test": "npm run build:css && vitest run",
    "deploy": "npm run db:migrate && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.9",
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.154.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true,
    "@parcel/watcher": false
  }
}
